{{!
    @template mod_response/summary

    The purpose of this template is to provide the structure for viewing the learner's
    summary of completed responses in a course. The actual structure for each response
    is delegated out, this is merely a shell.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * sections - an array of section objects e.g. from flexsections format, contains:
        * section_title - the section title
        * responses - an array of responses whose contents is ultimately a block called {render}
                      that is the rendered layout from a single response subplugin

    Example context (json):
    {
        "sections": [
            {
                "section_title": "Topic 1",
                "responses": [
                    { "render": "<div>...</div>" }
                ]
            }
        ]
    }
}}
<div class="response activity-course">
{{# sections }}
    <div class="activity-section-container">
    <h3 class="activity-section">{{section_title}}</h3>
    {{# responses }}
        <div class="activity-container">
        {{{render}}}
        </div>
    {{/ responses }}
    </div>
    <hr />
{{/ sections }}
</div>