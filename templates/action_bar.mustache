{{!
    @template mod_response/action_bar

    Copied and altered from grade/report/grader/templates/action_bar.mustache

    Actions bar for responses.

    Context variables required for this template:
    * generalnavselector - The data object containing the required properties to render the general navigation selector.
    * groupselector - (optional) HTML that outputs the group selector

    Example context (json):
    {
        "initialselector": {
            "rtl": false,
            "renderlater": false,
            "usebutton": true,
            "buttoncontent": "Example dropdown button",
            "dropdowncontent": "Some body content to render right now",
            "parentclasses": "my-dropdown",
            "buttonclasses": "my-button",
            "dropdownclasses": "my-cool-dropdown",
            "instance": 25
        }
    }
}}
<div class="container-fluid tertiary-navigation full-width-bottom-border">
    <div class="row">
            <div class="navitem">
                {{#searchdropdown}}
                    {{>core/comboboxsearch}}
                {{/searchdropdown}}
            </div>
            <div class="navitem-divider"></div>
            <div class="navitem d-flex flex-column align-self-center">
                {{#initialselector}}
                    {{>core/comboboxsearch}}
                {{/initialselector}}
            </div>
    </div>
</div>
