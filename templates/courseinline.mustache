{{!
    @template mod_response/courseinline

    The purpose of this template is to render an activity instance inside the course view.

    Classes required for JS:
    * response, on a parent of the content block
    * user-response
    * responsetype-{responsetype}
    * has-form

    Data attributes required for JS:
    * context if provided

    Context variables required for this template:
    * description - activity description if relevant
    * question - the prompt question for the activity
    * contextid - the context id for the activity (usually only in inline view)
    * form - the form object where relevant for the activity
    * responsetype - the name of the type of response, e.g. 'poll'
    * user_answer - rendered user's answer if already completed

    Example context (json):
    {
        "fullpage": true,
        "heading": "This learning response",
        "question": "Do you like learning responses?",
        "contextid": 64,
        "form": { a string that contains a rendered Moodle form's HTML }
    }
}}
    {{#description}}
        <div class="no-overflow">{{{description}}}</div>
    {{/description}}
    <div class="no-overflow">
        <p>{{{question}}}</p>
    </div>
    {{# form }}
        <div class="response" data-context="{{contextid}}">
            <div class="user-response responsetype-{{responsetype}} has-form">
                {{{form}}}
            </div>
            {{#can_see_all}}
                <div class="manage-links">
                    <a href="{{{viewall_url}}}">{{# str }} viewallresponses, response{{/ str }}</a>
                </div>
            {{/can_see_all}}
        </div>
        {{#js}}
        require(['mod_response/ajaxform'], function(form) {
            form.init('div.response[data-context={{contextid}}]');
        });
        {{/js}}
    {{/ form }}
    {{# user_answer }}
        {{{user_answer}}}
    {{/ user_answer }}