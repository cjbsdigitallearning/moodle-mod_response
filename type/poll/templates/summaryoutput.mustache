{{!
    @template responsetype_poll/summaryoutput

    The purpose of this template is to render the summary view for a learner of
    all their responses, or at least a specific instance inside the summary view.

    Classes required for JS:
    * aggregate (for chart behaviour)

    Data attributes required for JS:
    * response

    Context variables required for this template:
    * icon - the HTML for the icon indicating what type of activity it is
    * activity_title - the title of the activity
    * activity_question - the question prompt given in the activity
    * user_choice - text of the user's choice
    * user_response - reflection text for the response if given
    * timemodified_date - date/time the response was modified
    * response_id - id of the response (as per response table)
    * aggregate - stringified JSON object containing all the chart data
    * colours - stringified JSON array of colours to use in the chart

    Example context (json):
    {
        "icon": "<img class=\"smallicon\" alt=\"\" src=\"http://your.moodle.here/theme/image.php/clean/responsetype_poll/1506688378/icon\">",
        "activity_title": "The weather",
        "activity_question": "What's the weather doing today?",
        "user_choice": "Sunny."
        "user_response": "It's sunny outside and it's warm for October.",
        "timemodified_date": "02/10/17",
        "response_id": "1",
        "aggregate": "{\"group\":{\"title\":\"Answers given by your study group\",\"labels\":[\"Sunny\",\"Cloudy\",\"Stormy\",\"Raining\",\"Other\"],\"data\":[0,2,0,0,0]},\"all\":{\"title\":\"Answers given by all students\",\"labels\":[\"Sunny\",\"Cloudy\",\"Stormy\",\"Raining\",\"Other\"],\"data\":[0,2,0,0,0]} }",
        "colours": "[\"#f3c300\",\"#875692\",\"#f38400\",\"#a1caf1\",\"#be0032\",\"#c2b280\",\"#7f180d\",\"#008856\",\"#e68fac\",\"#0067a5\"]"
    }
}}
<div class="activity-title responsetype-poll" data-response="{{response_id}}">
    <h4>{{{icon}}} {{{activity_title}}}</h4>

    <h5>{{{activity_question}}}</h5>

    <div class="row">
        <div class="col">
            <div class="aggregate"></div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="user-wrote">
                {{# user_choice}}
                    {{# str }} youanswered, responsetype_poll,
                        { "answer":
                            {{# quote}}
                                <div class="user-answer">{{{user_choice}}}</div>{{#user_response}}:{{/user_response}}{{^user_response}}.{{/user_response}}
                            {{/ quote}}
                        }
                    {{/ str }}
                {{/ user_choice}}
                {{^ user_choice}}
                    {{# str }} noresponse, responsetype_poll {{/ str }}
                {{/ user_choice}}

                {{#user_response}}
                    <div class="user-reflection">{{{user_response}}}</div>
                {{/user_response}}

                <div class="clearfix"></div>
                <div class="context-link text-right">
                    <span class="time-completed">{{{timemodified_date}}}</span>
                </div>
            </div>
        </div>
    </div>
</div>
{{#js}}
require(['mod_response/summarychart'], function(summarychart) {
    summarychart({{response_id}}, {{{aggregate}}}, {{{colours}}}, {{#quote}}{{# str }} selectedby, responsetype_poll {{/ str }}{{/quote}});
})
{{/js}}