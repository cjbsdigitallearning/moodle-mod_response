{{!
    @template responsetype_text/responselayout

    The purpose of this template is to render an activity instance. It connects to mod_response/response
    to render additional generic structural HTML.

    Classes required for JS:
    * user-response, has-form

    Data attributes required for JS:
    * response_id

    Context variables required for this template:
    * response_id - id of the response itself (as per response table)
    * form - rendered form HTML for the activity

    Example context (json):
    {
        "response_id": 2,
        "form": { a string that contains a rendered Moodle form's HTML }
    }
}}
{{< mod_response/response}}
{{$content}}
    <div class="user-response responsetype-text has-form" data-response="{{{response_id}}}">
        {{{form}}}
    </div>
{{/content}}
{{/ mod_response/response}}