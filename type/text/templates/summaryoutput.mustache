{{!
    @template responsetype_text/summaryoutput

    The purpose of this template is to render the summary view for a learner of
    all their responses, or at least a specific instance inside the summary view.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * icon - the HTML for the icon indicating what type of activity it is
    * activity_title - the title of the activity
    * activity_question - the question prompt given in the activity
    * user_response - response text
    * timemodified_date - date/time the response was modified
    * context_link - URL to the activity in context
    * response_id - id of the response (as per response table)

    Example context (json):
    {
        "icon": "<img class=\"smallicon\" alt=\"\" src=\"http://your.moodle.here/theme/image.php/clean/responsetype_text/1506688378/icon\">",
        "activity_title": "The weather",
        "activity_question": "What's the weather doing today?",
        "user_response": "It's sunny outside and it's warm for October.",
        "timemodified_date": "02/10/17",
        "context_link": "http://your.moodle.here/course/view.php?id=2#module-10",
        "response_id": "1",
    }
}}
<div class="activity-title responsetype-text" data-response="{{response_id}}">
    <h4>{{{icon}}} {{{activity_title}}}</h4>

    <h5>{{{activity_question}}}</h5>

    <div class="row">
        <div class="col-md-8">
            {{# user_response}}
                <div class="user-wrote">{{# str }} youwrote, responsetype_text {{/ str }}</div>
            {{/ user_response}}
            {{^ user_response}}
                <div class="user-wrote">{{# str }} noresponse, responsetype_text {{/ str }}</div>
            {{/ user_response}}
            <div class="user-answer">
                {{{user_response}}}
            </div>

            <div class="clearfix"></div>
            <div class="context-link text-right">
                <span class="time-completed">{{{timemodified_date}}}</span>
                <a class="btn btn-default" href="{{{context_link}}}">{{# str }} viewincontext, response {{/ str }}</a>
            </div>
        </div>
    </div>
</div>